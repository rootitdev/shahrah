[Unit]
Description=Shahrah traffic and cost dashboard
After=network.target

[Service]
User=shahrah-traffic
StateDirectory=shahrah-traffic
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/shahrah-traffic/dashboard.py --db /var/lib/shahrah-traffic/dashboard.db --port 8795
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
