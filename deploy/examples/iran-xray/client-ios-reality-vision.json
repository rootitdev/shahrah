{
  "log": { "loglevel": "warning" },
  "dns": {
    "servers": [
      {
        "address": "localhost",
        "domains": ["geosite:category-ir", "geosite:private"]
      },
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIPv4",
    "disableFallback": true
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "udp": true }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [{
          "address": "entry.example.com",
          "port": 443,
          "users": [{
            "id": "12b29642-dd65-427b-98a1-4d02ed472150",
            "encryption": "none",
            "flow": "xtls-rprx-vision"
          }]
        }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.cloudflare.com",
          "fingerprint": "ios",
          "publicKey": "-LsvFSSWY2t6LMyP23GAhk2I-64S3x6VakVCoVUQ9iM",
          "shortId": "45a83332119989cd",
          "spiderX": ""
        }
      }
    },
    { "tag": "DIRECT", "protocol": "freedom" },
    { "tag": "BLOCK", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "domain": ["geosite:category-ir", "geosite:private"],
        "outboundTag": "DIRECT"
      },
      { "type": "field", "ip": ["geoip:ir", "geoip:private"], "outboundTag": "DIRECT" },
      { "type": "field", "ip": ["::/0"], "outboundTag": "BLOCK" },
      { "type": "field", "network": "tcp,udp", "outboundTag": "proxy" }
    ]
  }
}
